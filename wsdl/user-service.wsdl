    </operation>
    <operation name="getHomeDirectory">
      <soap:operation soapAction="urn:upbcientifica:user-service#getHomeDirectory" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="getUserStorageInfo">
      <soap:operation soapAction="urn:upbcientifica:user-service#getUserStorageInfo" style="document"/>
      <input><soap:body use="literal"/></input>
