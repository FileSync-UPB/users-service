      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="assignRole">
      <soap:operation soapAction="urn:upbcientifica:user-service#assignRole" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="removeRole">
      <soap:operation soapAction="urn:upbcientifica:user-service#removeRole" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="getRoles">
      <soap:operation soapAction="urn:upbcientifica:user-service#getRoles" style="document"/>
      <input><soap:body use="literal"/></input>
