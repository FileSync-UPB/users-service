    </operation>
    <operation name="updateQuota">
      <soap:operation soapAction="urn:upbcientifica:user-service#updateQuota" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="enableService">
      <soap:operation soapAction="urn:upbcientifica:user-service#enableService" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="disableService">
