      <output message="tns:getHomeDirectoryResponse"/>
    </operation>
    <operation name="getUserStorageInfo">
      <input message="tns:getUserStorageInfoRequest"/>
      <output message="tns:getUserStorageInfoResponse"/>
    </operation>
  </portType>

  <binding name="UserServiceBinding" type="tns:UserServicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="authenticateUser">
      <soap:operation soapAction="urn:upbcientifica:user-service#authenticateUser" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="validateToken">
      <soap:operation soapAction="urn:upbcientifica:user-service#validateToken" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="createUser">
      <soap:operation soapAction="urn:upbcientifica:user-service#createUser" style="document"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="updateUser">
      <soap:operation soapAction="urn:upbcientifica:user-service#updateUser" style="document"/>
      <input><soap:body use="literal"/></input>
